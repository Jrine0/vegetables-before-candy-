# Production Environment Variables for Netlify Deployment

# Backend API URL - will be updated with deployed backend URL
NEXT_PUBLIC_API_URL=https://academic-nft-backend.up.railway.app

# Enable mock API until backend is deployed
NEXT_PUBLIC_USE_MOCK_API=true

# Aptos Contract Addresses (Demo)
NEXT_PUBLIC_APTOS_MODULE_ADDRESS=0x0
NEXT_PUBLIC_APTOS_ACCESS_MODULE_ADDRESS=0x0
NEXT_PUBLIC_APTOS_NETWORK=testnet

# App Configuration
NEXT_PUBLIC_APP_NAME="future me"
NEXT_PUBLIC_APP_DESCRIPTION="Transform academic achievements into dynamic NFTs"
NEXT_PUBLIC_APP_URL=https://future-me.netlify.app