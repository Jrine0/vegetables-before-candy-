# Production Environment Variables for Netlify Deployment

# Backend API URL - will be updated with deployed backend URL
NEXT_PUBLIC_API_URL=https://task-reward-backend.up.railway.app

# Enable mock API until backend is deployed
NEXT_PUBLIC_USE_MOCK_API=true

# Stellar Soroban Contract Addresses (Demo)
NEXT_PUBLIC_SOROBAN_CONTRACT_ID=C...
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# App Configuration
NEXT_PUBLIC_APP_NAME="vegetables-before-candy"
NEXT_PUBLIC_APP_DESCRIPTION="Complete tasks before claiming rewards on Stellar"
NEXT_PUBLIC_APP_URL=https://vegetables-before-candy.netlify.app